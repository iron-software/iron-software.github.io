# Archetype-N API-overview enhancement (post-DocFX) reads these keys.
# Provider auto-detect: CLAUDE_API_KEY -> Anthropic; else OPENAI_API_KEY -> OpenAI.
# Copy this file to .env (gitignored) and fill in real keys.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_API_KEY=ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# ARCHETYPE_N_PROVIDER=claude        # force claude|openai (default: auto-detect by key)
# ARCHETYPE_N_MODEL=claude-sonnet-4-6 # override the model (defaults: claude-sonnet-4-6 / gpt-4o)

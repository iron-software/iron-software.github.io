<div class="modal modal_new trial-license-new cv-auto" id="trial-license" tabindex="-1" data-bs-backdrop="true" data-form-id="dbd072d1-1098-4c98-bdc3-7255fc2e0d6b" style="" data-js-modal-id="trial-license">
  <div class="modal-dialog modal-dialog-scrollable modal-fullscreen">
    <div class="modal-content p-0">
      <div class="position-relative z-1">
        <i class="fa-solid fa-x" data-bs-dismiss="modal" aria-hidden="true" style="position:absolute; top:12px; right:12px; width:40px; height:40px; cursor:pointer; display:flex; align-items:center; justify-content:center;font-size:18px; color:#181818;"></i>
      </div>
      <div class="modal-body p-0">
        <div id="formtrial" class="modal_body">
          <div class="modal-loaded donotdelete"></div>
          <div class="d-flex h-100 gap-0">
            <div class="left d-none d-lg-block">
              <div class="wrapper">
                <div style="flex:0 1 56px;">
                  <!-- spacer -->
                </div>
                <div>
                  <img src="{{_modalWindowProductImage}}" alt="{{_productName}}_for_dotnet_log2o" class="product_logo" loading="lazy">
                </div>
                <div style="flex:0 1 48px;">
                  <!-- spacer -->
                </div>
                <div class="bg_wrapper group__started_for_free">
                  <section class="title">
                    <div class="h1">
                      <img src="{{_rel}}styles/imgs/modal/key_circle_blue.svg" width="40" height="40" alt="Blue key in circle" loading="lazy">Get started for FREE
                    </div>
                    <div class="subtitle">No credit card required</div>
                  </section>
                  <section class="content">
                    <article>
                      <div class="h2">Test in a live environment</div>
                      <p>Test in production without watermarks. <br>Works wherever you need it to. </p>
                      <div class="floating_icon">
                        <i class="fa-kit fa-square-arrow-in"></i>
                      </div>
                    </article>
                    <article>
                      <div class="h2">Fully-functional product</div>
                      <p>Get 30 days of fully functional product. <br>Have it up and running in minutes. </p>
                      <div class="floating_icon">
                        <i class="fa-kit fa-calendar-bottom-check"></i>
                      </div>
                    </article>
                    <article>
                      <div class="h2">24/5 technical support</div>
                      <p>Full access to our support engineering team during your product trial</p>
                      <div class="floating_icon">
                        <i class="fa-regular fa-messages-question"></i>
                      </div>
                    </article>
                  </section>
                </div>
                <div class="bg_wrapper group__started_for_free_completed">
                  <section class="title">
                    <div class="h1">
                      <img src="{{_rel}}styles/imgs/modal/checked_circle_grey.svg" width="40" height="40" alt="Grey key in circle" loading="lazy">Get started for FREE
                    </div>
                    <div class="subtitle">The trial form was submitted successfully.</div>
                  </section>
                  <section class="content"></section>
                </div>
                <div class="bg_wrapper group__booking">
                  <section class="title">
                    <div class="h1">
                      <img src="{{_rel}}styles/imgs/modal/calendar_circle_blue.svg" width="40" height="40" alt="Calendar in circle" loading="lazy">Book Free Live Demo
                    </div>
                    <div class="subtitle">No contact, no card details, no commitments <span class="detail">Book a 30-minute, personal demo.</span>
                    </div>
                  </section>
                  <section class="content">
                    <div class="title_of_listing">Here's what to expect:</div>
                    <article>
                      <p>A live demo of our product and its key features</p>
                      <div class="floating_icon">
                        <i class="fa-regular fa-circle-check"></i>
                      </div>
                    </article>
                    <article>
                      <p>Get project specific feature recommendations</p>
                      <div class="floating_icon">
                        <i class="fa-regular fa-circle-check"></i>
                      </div>
                    </article>
                    <article>
                      <p>All your questions are answered to make sure you have all the information you need. (No commitment whatsoever.)</p>
                      <div class="floating_icon">
                        <i class="fa-regular fa-circle-check"></i>
                      </div>
                    </article>
                  </section>
                </div>
                <div class="bg_wrapper group__booking_completed">
                  <section class="title">
                    <div class="h1">
                      <img src="{{_rel}}styles/imgs/modal/checked_circle_grey.svg" width="40" height="40" alt="Grey key in circle" loading="lazy">Book Free Live Demo
                    </div>
                    <div class="subtitle">Your booking has been completed <span class="detail">Check your e-mail for confirmation</span>
                    </div>
                  </section>
                  <section class="content"></section>
                </div>
                <div style="flex:1 1 auto;">
                  <!-- spacer -->
                </div>
                <div class="modal_new_trial__support_team">
                  <div class="image_wrapper">
                    <img class="lazy" width="64" height="64" aria-label="" src="{{_rel}}styles/imgs/support-team/support-team-member-6.webp" loading="lazy" alt="Support Team Member 6 related to The C# PDF Library">
                    <img class="lazy" width="64" height="64" aria-label="" src="{{_rel}}styles/imgs/support-team/support-team-member-14.webp" loading="lazy" alt="Support Team Member 14 related to The C# PDF Library">
                    <img class="lazy" width="64" height="64" aria-label="" src="{{_rel}}styles/imgs/support-team/support-team-member-4.webp" loading="lazy" alt="Support Team Member 4 related to The C# PDF Library">
                    <img class="lazy" width="64" height="64" aria-label="" src="{{_rel}}styles/imgs/support-team/support-team-member-2.webp" loading="lazy" alt="Support Team Member 2 related to The C# PDF Library">
                  </div>
                  <div class="online">Online 24/5</div>
                </div>
                <div class="need_help">
                  <strong>Need help?</strong> Our sales team would be glad to help you.
                </div>
                <a href="https://ironsoftware.com/enterprise/trial" class="enterprise-trial__cta">Try the Enterprise Trial <i class="fa-solid fa-arrow-right"></i>
                </a>
                <div style="flex:0 1 48px;">
                  <!-- spacer -->
                </div>
              </div>
            </div>
            <div class="right" style="flex:1 1 auto;">
              <div class="wrapper">
                <div style="flex:0 1 80px;">
                  <!-- spacer -->
                </div>
                <div class="d-none text-center">
                  <img loading="lazy" src="{{_modalWindowProductImage}}" alt="ironpdf_for_dotnet_log2o" class="product_logo" style="max-height:50px;" height="50" width="auto">
                </div>
                <!-- Page One -->
                <div class="right_content page_one">
                  <div class="header">
                    <div>
                      <img src="{{_rel}}styles/imgs/modal/key_circle_blue.svg" width="80" height="80" alt="Key in blue circle" loading="lazy">
                    </div>
                    <div class="h2">Get your free <strong class="d-block d-sm-inline">30-day Trial Key</strong> instantly. </div>
                  </div>
                  <div style="height:48px;">
                    <!-- spacer -->
                  </div>
                  <div class="placeholder__hsform--one">
                    
                  </div>
                  <div>
                    <div class="no_credit_required">
                      <img loading="lazy" src="{{_rel}}styles/imgs/modal/bullet_checked.svg" width="16" height="16" alt="bullet_checked">No credit card or account creation required
                    </div>
                  </div>
                </div>
                <!-- Page Two -->
                <div class="right_content page_two" style="display:none;">
                  <div class="header">
                    <div>
                      <img src="{{_rel}}styles/imgs/modal/key_circle_blue.svg" width="80" height="80" alt="Key in blue circle" loading="lazy">
                    </div>
                    <div class="h2">Get your free <strong class="d-block d-sm-inline">30-day Trial Key</strong> instantly. </div>
                  </div>
                  <div style="height:24px;">
                    <!-- spacer -->
                  </div>
                  <div class="placeholder__hsform--two"></div>
                  <div>
                    <div class="no_credit_required">
                      <img loading="lazy" src="{{_rel}}styles/imgs/modal/bullet_checked.svg" width="16" height="16" alt="Blue key in circle">No credit card or account creation required
                    </div>
                  </div>
                </div>
                <!-- Page Three (meeting form) -->
                <div class="right_content page_three" style="display:none;">
                  <div class="header">
                    <div><img src="{{_rel}}styles/imgs/modal/green_check_in_orange_circle.svg" width="80" height="80" alt="Green Check in orange circle" loading="lazy"></div>
                    <div class="h2">The trial form was submitted <span class="iron_font--bold">successfully</span>.</div>
                  </div>

                  <div style="height:24px;"><!-- spacer --></div>

                  <div class="hsform_schedule_meeting">
                    <!-- Start of Meetings Embed Script -->
                    <div class="meetings-iframe-container" data-src="https://hub.ironsoftware.com/meetings/iron-software-sales/demo-trial?embed=true"></div>
                    <!-- End of Meetings Embed Script -->
                  </div>
                </div>
                <!-- Page Submitted -->
                <div class="right_content page_submitted formright_submitted" style="display:none;">
                  <div class="d-none d-md-block" style="flex:0 1 80px;">
                    <!-- spacer -->
                  </div>
                  <div class="d-block d-md-none" style="flex:0 1 24px;">
                    <!-- spacer -->
                  </div>
                  <div>
                    <img loading="lazy" src="{{_rel}}styles/imgs/modal/green_check_in_orange_circle.svg" width="100" height="100" alt="badge_greencheck_in_yellowcircle">
                  </div>
                  <div class="title">Thank you for starting a trial</div>
                  <div class="text p-3">
                    <p>Please check your email for the trial license key.</p>
                    <p>If you don’t receive an email, please start a <a href="#livechat" onclick="return window.HubSpotConversations.widget.open()">live chat</a> or email <a href="mailto:support@ironsoftware.com">support@ironsoftware.com</a>
                    </p>
                  </div>
                  <div>
                    <div style="margin:0 auto; width:100%; max-width:248px;">
                      <div class="my-3">
                        <a class="trial-license__action-button trial-license__action-button_red m-0" style="width:100%; font-size:14px;" href="{{_sideBarDownloadLink}}" target="_blank">
                          <i class="trial-license__action-button-icon nuget-icon-white2"></i>
                          <span class="trial-license__action-button-text">Install with NuGet</span>
                        </a>
                      </div>
                      <div class="my-3">
                        <a class="trial-license__action-button trial-license__action-button_white m-0" style="width:100%; font-size:14px;" href="{{_modalWindowLicensingLink}}">
                          <span class="trial-license__action-button-text">View Licensing</span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
                <div style="flex:1 1 96px">
                  <!-- spacer -->
                </div>
                <section class="trusted_by">
                  <ul class="our_clients">
                    <li>
                      <img class="img-fluid" loading="lazy" src="{{_rel}}styles/imgs/modal/logo_aetna.svg" alt="Logo Aetna" width="80" height="20">
                    </li>
                    <li>
                      <img class="img-fluid" loading="lazy" src="{{_rel}}styles/imgs/modal/logo_nasa.svg" alt="Logo NASA" width="64" height="52">
                    </li>
                    <li>
                      <img class="img-fluid" loading="lazy" src="{{_rel}}styles/imgs/modal/logo_ge.svg" alt="Logo GE" width="54" height="54">
                    </li>
                    <li>
                      <img class="img-fluid" loading="lazy" src="{{_rel}}styles/imgs/modal/logo_porsche.svg" alt="Logo Porsche" width="40" height="52">
                    </li>
                    <li>
                      <img class="img-fluid" loading="lazy" src="{{_rel}}styles/imgs/modal/logo_usds.svg" alt="Logo USDA" width="54" height="54">
                    </li>
                    <li>
                      <img class="img-fluid" loading="lazy" src="{{_rel}}styles/imgs/modal/logo_qatar.svg" alt="Logo Qatar" width="114" height="32">
                    </li>
                  </ul>
                  <div class="h2">Join Millions of Engineers who’ve tried {{_productName}}</div>
                </section>
                <div style="flex:0 1 80px">
                  <!-- spacer -->
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<dialog id="dialogHsMeetingFormFullScreen">
  <div style="position:relative; display:flex; align-items:center; height:100%; width:100%;">
    <div class="iron_loader_wrapper" style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%);">
      <div class="iron_loader"></div>
    </div>
    <div class="close_button">
      <i class="fa-solid fa-x"></i>
    </div>
    <div class="meetings-iframe-container z-1" data-src="https://hub.ironsoftware.com/meetings/iron-software-sales/demo-trial?embed=true"></div>
  </div>
</dialog>
